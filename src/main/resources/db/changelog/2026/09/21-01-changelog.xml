<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1789987098848-1" author="alex">
        <createSequence incrementBy="50" sequenceName="cart_item_seq" startValue="1"/>
    </changeSet>
    <changeSet id="1789987098848-2" author="alex">
        <createSequence incrementBy="50" sequenceName="cart_seq" startValue="1"/>
    </changeSet>
    <changeSet id="1789987098848-3" author="alex">
        <createSequence incrementBy="50" sequenceName="item_seq" startValue="1"/>
    </changeSet>
    <changeSet id="1789987098848-4" author="alex">
        <createSequence incrementBy="50" sequenceName="orders_seq" startValue="1"/>
    </changeSet>
    <changeSet id="1789987098848-5" author="alex">
        <createSequence incrementBy="50" sequenceName="revinfo_seq" startValue="1"/>
    </changeSet>
    <changeSet id="1789987098848-6" author="alex">
        <createTable tableName="cart">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_cart"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1789987098848-7" author="alex">
        <createTable tableName="cart_counted_items">
            <column name="cart_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_cart_counteditems"/>
            </column>
            <column name="counted_items_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_cart_counteditems"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1789987098848-8" author="alex">
        <createTable tableName="cart_item">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_cart_item"/>
            </column>
            <column name="item_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="count" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1789987098848-9" author="alex">
        <createTable tableName="item">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_item"/>
            </column>
            <column name="title" type="VARCHAR(255)"/>
            <column name="description" type="VARCHAR(255)"/>
            <column name="img_path" type="VARCHAR(255)"/>
            <column name="price" type="DECIMAL"/>
        </createTable>
    </changeSet>
    <changeSet id="1789987098848-10" author="alex">
        <createTable tableName="orders">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_orders"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1789987098848-11" author="alex">
        <createTable tableName="orders_items">
            <column name="order_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_orders_items"/>
            </column>
            <column name="items_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_orders_items"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1789987098848-12" author="alex">
        <createTable tableName="revchanges">
            <column name="rev" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="entityname" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
    <changeSet id="1789987098848-13" author="alex">
        <createTable tableName="revinfo">
            <column name="rev" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_revinfo"/>
            </column>
            <column name="revtstmp" type="BIGINT"/>
        </createTable>
    </changeSet>
    <changeSet id="1789987098848-14" author="alex">
        <addUniqueConstraint columnNames="counted_items_id" constraintName="uc_cart_counted_items_counteditems"
                             tableName="cart_counted_items"/>
    </changeSet>
    <changeSet id="1789987098848-15" author="alex">
        <addForeignKeyConstraint baseColumnNames="item_id" baseTableName="cart_item" constraintName="FK_CART_ITEM_ON_ITEM"
                                 referencedColumnNames="id" referencedTableName="item"/>
    </changeSet>
    <changeSet id="1789987098848-16" author="alex">
        <addForeignKeyConstraint baseColumnNames="cart_id" baseTableName="cart_counted_items"
                                 constraintName="fk_carcouite_on_cart" referencedColumnNames="id"
                                 referencedTableName="cart"/>
    </changeSet>
    <changeSet id="1789987098848-17" author="alex">
        <addForeignKeyConstraint baseColumnNames="counted_items_id" baseTableName="cart_counted_items"
                                 constraintName="fk_carcouite_on_counted_item" referencedColumnNames="id"
                                 referencedTableName="cart_item"/>
    </changeSet>
    <changeSet id="1789987098848-18" author="alex">
        <addForeignKeyConstraint baseColumnNames="items_id" baseTableName="orders_items"
                                 constraintName="fk_ordite_on_counted_item" referencedColumnNames="id"
                                 referencedTableName="cart_item"/>
    </changeSet>
    <changeSet id="1789987098848-19" author="alex">
        <addForeignKeyConstraint baseColumnNames="order_id" baseTableName="orders_items"
                                 constraintName="fk_ordite_on_order" referencedColumnNames="id"
                                 referencedTableName="orders"/>
    </changeSet>
    <changeSet id="1789987098848-20" author="alex">
        <addForeignKeyConstraint baseColumnNames="rev" baseTableName="revchanges"
                                 constraintName="fk_revchanges_on_default_tracking_modified_entities_changelog"
                                 referencedColumnNames="rev" referencedTableName="revinfo"/>
    </changeSet>

</databaseChangeLog>